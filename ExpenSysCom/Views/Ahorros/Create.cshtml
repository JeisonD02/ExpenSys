@model ExpenSysCom.ViewModels.AhorroViewModel

@{
    ViewData["Title"] = "Crear Ahorro";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2 class="text-center my-4">Crear Nuevo Ahorro</h2>

        <!-- Mostrar resumen de errores -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="form-group mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Porcentaje" class="form-label"></label>
                        <input asp-for="Porcentaje" class="form-control" type="number" min="1" max="100" />
                        <span asp-validation-for="Porcentaje" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Intensidad" 
                                class="form-label">Intensidad</label>
                        <select asp-for="Intensidad" 
                                class="form-control" 
                                asp-items="Html.GetEnumSelectList<Intensidad>()">

                            <option value="">-- Selecciona una intensidad --</option>
                        </select>
                        <span asp-validation-for="Intensidad" class="text-danger"></span>
                    </div>

                    <!-- Botones mejorados -->
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-1"></i> Crear Ahorro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
