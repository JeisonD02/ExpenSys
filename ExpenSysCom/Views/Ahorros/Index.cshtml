@model IEnumerable<ExpenSysCom.ViewModels.AhorroViewModel>

@{
    ViewData["Title"] = "Ahorros";
}

<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/style/Ahorros/Index.css" rel="stylesheet" />
</head>


<h1 class="mb-4">Mis Ahorros</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Porcentaje</th>
            <th>Estado</th>
            <th>Intensidad</th>
            <th class="text-center">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ahorro in Model)
        {
            <tr>
                <td>@ahorro.Nombre</td>
                <td>@ahorro.Descripcion</td>
                <td class="fw-bold text-success">@ahorro.Porcentaje %</td>
                <td>
                    <span class="badge @(ahorro.Estado == Estado.Activo ? "bg-success"
                                                                      : ahorro.Estado == Estado.Pausado ? "bg-warning text-dark"
                                                                      : "bg-secondary")">
                        @ahorro.Estado
                    </span>
                </td>
                <td>
                    @ahorro.Intensidad
                </td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@ahorro.IdAhorro" class="btn btn-sm btn-info me-1" title="Detalles">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@ahorro.IdAhorro" class="btn btn-sm btn-primary me-1" title="Editar">
                        <i class="fas fa-pen"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@ahorro.IdAhorro" class="btn btn-sm btn-danger" title="Eliminar">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Nuevo Ahorro
    </a>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary ms-2">
        <i class="fas fa-arrow-left"></i> Volver al Inicio
    </a>
</div>

