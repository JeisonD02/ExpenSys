@model ExpenSysCom.ViewModels.AhorroViewModel

@{
    ViewData["Title"] = "Detalles del Ahorro";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2 class="text-center my-4">Detalles del Ahorro</h2>
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Model.Descripcion</dd>

                    <dt class="col-sm-4">Porcentaje</dt>
                    <dd class="col-sm-8">@Model.Porcentaje.ToString("N2") %</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">@Model.NombreEstado</dd>

                    <dt class="col-sm-4">Intensidad</dt>
                    <dd class="col-sm-8">@Model.NombreIntensidad</dd>
                </dl>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <a asp-action="Edit" asp-route-id="@Model.IdAhorro" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
        </div>
    </div>
</div>
