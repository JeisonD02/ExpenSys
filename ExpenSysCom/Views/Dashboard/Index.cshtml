@model ExpenSysCom.ViewModels.DashboardViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>ExpenSys - Panel de Gestión</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/styles/dashboard/Index.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="wrapper d-flex">

        <!-- Aside -->
        <aside class="dashboard-aside">
            <div class="text-center mb-4">
                <img src="~/resources/ExpenSys-LogoSinFondo.png" alt="Logo" class="logo" style="width:70px;">
            </div>

            <div class="aside-sections">
                <div class="aside-section">
                    <h6>Finanzas</h6>
                    <a href="/Metas" class="nav-link"><i class="fas fa-bullseye"></i> Metas</a>
                    <a href="/Ahorros" class="nav-link"><i class="fas fa-piggy-bank"></i> Ahorros</a>
                    <a href="/AportesAhorro" class="nav-link"><i class="fas fa-arrow-up"></i> Aportar</a>
                    <a href="/GastarAhorro" class="nav-link"><i class="fas fa-arrow-down"></i> Gastar</a>
                </div>

                <div class="aside-section">
                    <h6>Movimientos</h6>
                    <a href="/Gastos" class="nav-link"><i class="fas fa-wallet"></i> Gastos</a>
                    <a href="/Ingresos" class="nav-link"><i class="fas fa-coins"></i> Ingresos</a>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="aside-section">
                        <h6>Administración</h6>
                        <a href="/CategoriasGastos" class="nav-link"><i class="fas fa-tags"></i> Categorías Gastos</a>
                        <a href="/CategoriasIngresos" class="nav-link"><i class="fas fa-folder"></i> Categorías Ingresos</a>
                        <a href="/Estados" class="nav-link"><i class="fas fa-flag"></i> Estados</a>
                        <a href="/Intensidades" class="nav-link"><i class="fas fa-chart-line"></i> Intensidades</a>
                        <a href="/Usuarios" class="nav-link"><i class="fas fa-users"></i> Usuarios</a>
                    </div>
                }

                <div class="aside-section">
                    <h6>Cuenta</h6>
                    <a href="/Account" class="nav-link"><i class="fas fa-wallet"></i> Mi Cuenta</a>
                </div>
            </div>

            <div class="logout-btn">
                <a href="/Login" class="btn btn-danger w-100">
                    <i class="fas fa-right-from-bracket me-2"></i> Cerrar Sesión
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="dashboard-main flex-grow-1">
            <!-- Bienvenida -->
            <div class="welcome-message">
                <h2>Bienvenido, @User.Identity.Name 👋</h2>
                <h2>Bienvenido, @Model.NombreUsuario 👋</h2>

                <p class="text-muted">Aquí está el resumen de tus finanzas</p>
            </div>

            <!-- Cards principales -->
            <div class="dashboard-cards">
                <div class="card border-start border-4 border-danger">
                    <h5><i class="fas fa-wallet me-2 text-danger"></i> Total Gastos</h5>
                    <p class="text-danger fw-bold fs-5">$@Model.TotalGastos.ToString("N0")</p>
                </div>
                <div class="card border-start border-4 border-success">
                    <h5><i class="fas fa-coins me-2 text-success"></i> Total Ingresos</h5>
                    <p class="text-success fw-bold fs-5">$@Model.TotalIngresos.ToString("N0")</p>
                </div>
                <div class="card text-muted d-flex align-items-center justify-content-center">
                    <span><i class="fas fa-lightbulb me-2"></i> Próximamente</span>
                </div>
            </div>

            <!-- Totales ampliados -->
            <div class="row mt-3">
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-primary h-100">
                        <div class="card-body">
                            <h5 class="card-title">Total Ingresos</h5>
                            <p class="card-text">Proximamente...</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-danger h-100">
                        <div class="card-body">
                            <h5 class="card-title">Total Gastos</h5>
                            <p class="card-text">Proximamente...</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-success h-100">
                        <div class="card-body">
                            <h5 class="card-title">Metas</h5>
                            <p class="card-text">Proximamente...</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-info h-100">
                        <div class="card-body">
                            <h5 class="card-title">Ahorros</h5>
                            <p class="card-text">Proximamente...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filtro gráfico -->
            <div class="mt-4 mb-2">
                <label for="filtro">Filtrar por:</label>
                <select id="filtro" class="form-select w-auto d-inline-block">
                    <option value="dia">Día</option>
                    <option value="semana">Semana</option>
                    <option value="mes">Mes</option>
                    <option value="ano">Año</option>
                </select>
            </div>

            <!-- Gráfico -->
            <div class="chart-container">
                <canvas id="graficoFinanzas"></canvas>
            </div>
        </main>

    </div>

    <script>
        // Datos del modelo
        const datos = {
            dia: { labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Dias)), ingresos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IngresosDia)), gastos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GastosDia)) },
            semana: { labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Semanas)), ingresos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IngresosSemana)), gastos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GastosSemana)) },
            mes: { labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Meses)), ingresos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IngresosMes)), gastos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GastosMes)) },
            ano: { labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Anos)), ingresos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.IngresosAno)), gastos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GastosAno)) }
        };

        // Configuración del gráfico
        const ctx = document.getElementById('graficoFinanzas').getContext('2d');
        let grafico = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: datos.dia.labels,
                datasets: [
                    { label: 'Ingresos', data: datos.dia.ingresos, backgroundColor: 'rgba(54, 162, 235, 0.7)' },
                    { label: 'Gastos', data: datos.dia.gastos, backgroundColor: 'rgba(255, 99, 132, 0.7)' }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'top' }, title: { display: true, text: 'Ingresos vs Gastos' } }, scales: { y: { beginAtZero: true } } }
        });

        // Actualizar gráfico según filtro
        document.getElementById('filtro').addEventListener('change', function () {
            const filtro = this.value;
            grafico.data.labels = datos[filtro].labels;
            grafico.data.datasets[0].data = datos[filtro].ingresos;
            grafico.data.datasets[1].data = datos[filtro].gastos;
            grafico.update();
        });
    </script>
</body>
</html>
