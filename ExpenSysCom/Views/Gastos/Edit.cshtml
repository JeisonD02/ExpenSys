@model GastoViewModel

@{
    ViewData["Title"] = "Editar Gasto";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2 class="text-center my-4">Editar Gasto</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdGasto" />

                    <div class="form-group mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <input asp-for="Descripcion" class="form-control" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Valor" class="form-label"></label>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Valor" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" class="form-control" type="date" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="IdCategoriaGasto" class="form-label">Categoría</label>
                        <select asp-for="IdCategoriaGasto" asp-items="Model.Categorias" class="form-control"></select>
                        <span asp-validation-for="IdCategoriaGasto" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-secondary mt-2">Cancelar y Volver a la Lista</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
