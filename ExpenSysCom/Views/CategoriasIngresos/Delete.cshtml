@model ExpenSysCom.Modelos.CategoriasIngreso

@{
    ViewData["Title"] = "Eliminar Categoría de Ingreso";
}

<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/style/categoriasIngreso/Delete.css" rel="stylesheet" />
</head>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Eliminar Categoría de Ingreso
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger text-center">
                        <strong>¡Atención!</strong> Esta acción es irreversible. ¿Estás seguro de que deseas eliminar esta categoría?
                    </div>
                    <dl class="row">
                        <dt class="col-sm-4"><i class="fas fa-tag me-2 text-muted"></i>Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>
                    </dl>
                    <form asp-action="Delete" class="d-flex justify-content-between mt-3">
                        <input type="hidden" asp-for="IdCategoriaIngreso" />
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
