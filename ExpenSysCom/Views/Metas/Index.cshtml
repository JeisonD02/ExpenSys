@model IEnumerable<ExpenSysCom.Models.Meta>

@{
    ViewData["Title"] = "Mis Metas";
}

<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/style/Metas/Index.css" rel="stylesheet" />
</head>

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- FORMULARIO FILTROS -->
<form method="get" asp-action="Index" class="row g-3 mb-3">
    <div class="col-auto">
        <label for="fechaInicio" class="form-label">Fecha Inicio:</label>
        <input type="date" id="fechaInicio" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
    </div>

    <div class="col-auto">
        <label for="fechaFin" class="form-label">Fecha Fin:</label>
        <input type="date" id="fechaFin" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
    </div>

    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> Filtrar
        </button>
    </div>
</form>

<!-- FORMULARIO EXPORTAR PDF -->
<form method="post" asp-action="ExportarPdf" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="fechaInicio" value="@ViewBag.FechaInicio" />
    <input type="hidden" name="fechaFin" value="@ViewBag.FechaFin" />
    <button type="submit" class="btn btn-danger">
        <i class="fas fa-file-pdf"></i> Generar PDF
    </button>
</form>

<!-- TABLA METAS -->
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Valor</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Ahorro Asociado</th>
            <th>Estado</th>
            <th class="text-center">Opciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No se encontraron metas en el rango seleccionado.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Valor.ToString("C")</td>
                    <td>@item.FechaInicio.ToShortDateString()</td>
                    <td>@item.FechaFin.ToShortDateString()</td>
                    <td>@item.IdAhorroNavigation?.Nombre</td>
                    <td>@item.Estado</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.IdMeta" class="btn btn-sm btn-primary me-1" title="Editar">
                            <i class="fas fa-pen"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.IdMeta" class="btn btn-sm btn-info me-1" title="Detalles">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.IdMeta" class="btn btn-sm btn-danger" title="Eliminar">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- BOTONES FINALES -->
<div class="mt-4">
    <a class="btn btn-success" asp-action="Create">
        <i class="fas fa-plus"></i> Nueva Meta
    </a>
    <a class="btn btn-secondary ms-2" asp-controller="Dashboard" asp-action="Index">
        <i class="fas fa-arrow-left"></i> Volver al Inicio
    </a>
</div>
