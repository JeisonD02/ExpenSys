@model ExpenSysCom.ViewModels.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <title>Registro - ExpenSys</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/styles/register/Index.css" />
</head>

<body>
    <div class="register-box">
        <h2>Crear Cuenta</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var error in ViewData.ModelState.Values.SelectMany(e => e.Errors))
            {
                <div class="alert alert-danger">@error.ErrorMessage</div>
            }
        }

        <form method="post" asp-controller="Register" asp-action="Index">
            <!-- Campos del ViewModel -->
            <input asp-for="Nombre" type="text" placeholder="Nombre de usuario" required />
            <input asp-for="NoDocumento" type="number" placeholder="Número de documento" required />
            <input asp-for="Email" type="email" placeholder="Correo electrónico" required />
            <input asp-for="Telefono" type="tel" placeholder="Teléfono" />
            <input asp-for="Password" type="password" placeholder="Contraseña" required />
            <input asp-for="ConfirmPassword" type="password" placeholder="Confirmar contraseña" required />

            <button type="submit" class="btn btn-primary">Registrarse</button>
        </form>

        <div class="extra-links">
            <p>¿Ya tienes cuenta? <a href="/Login">Inicia sesión</a></p>
        </div>
    </div>
</body>
</html>